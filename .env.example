# ===========================================
# Configuration Supabase (Vite)
# ===========================================
# URL de votre projet Supabase (Dashboard > Settings > API)
VITE_SUPABASE_URL=https://your-project-id.supabase.co

# Clé anon/public de Supabase (Dashboard > Settings > API > anon key)
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# ===========================================
# Instructions
# ===========================================
# 1. Copiez ce fichier vers .env
#    cp .env.example .env
#
# 2. Remplacez les valeurs par vos vraies clés Supabase
#
# 3. Ne JAMAIS commit le fichier .env
#    (il est déjà dans .gitignore)
#
# Note: Vite utilise le préfixe VITE_ (pas REACT_APP_)
# ===========================================
